# ==============================================================================
# Variáveis de Ambiente - Controle Financeiro
# Copie este arquivo para .env na raiz do projeto e configure com seus dados
# ==============================================================================

# Credenciais e conexão com o Banco de Dados PostgreSQL
POSTGRES_USER=seu_usuario_aqui
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=din_din_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# String de conexão completa com o PostgreSQL
DATABASE_URL=postgresql://seu_usuario_aqui:sua_senha_aqui@localhost:5434/din_din_db

# Porta de execução do servidor Backend Express
PORT=3000
