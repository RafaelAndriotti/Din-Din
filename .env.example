# ==============================================================================
# Variáveis de Ambiente - Controle Financeiro
# Copie este arquivo para .env na raiz do projeto e troque TODOS os valores "_aqui".
# A API não sobe enquanto houver valor de exemplo, variável faltando ou senha curta.
# ==============================================================================

# Admin do PostgreSQL: o contêiner cria este usuário como superusuário na primeira subida.
# Serve só para aplicar o init.sql; a API não conecta com ele. Senha com 12+ caracteres.
POSTGRES_USER=seu_usuario_aqui
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=din_din_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# Role com que a API conecta, criada pelo init.sql sem superusuário.
# Precisa ser diferente de POSTGRES_USER. Senha com 12+ caracteres.
APP_DB_USER=din_din_app
APP_DB_PASSWORD=senha_da_api_aqui

# Segredo que assina os tokens de login: 32+ caracteres aleatórios. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=segredo_do_jwt_aqui

# Porta de execução do servidor Backend Express
PORT=3000

# Só em produção (Render + Neon). Na sua máquina, deixe comentado: valem os padrões.
# POSTGRES_SSL=true     # o Neon exige TLS
# HOST=0.0.0.0          # o proxy com TLS do Render fica na frente da API
# TRUST_PROXY=1         # quantos proxies há na frente; o rate limit usa o IP real do usuário
